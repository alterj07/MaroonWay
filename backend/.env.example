# Supabase: Project Settings -> Database -> Connection string -> URI (session pooler, port 6543).
# Swap the scheme to postgresql+asyncpg:// for SQLAlchemy's async driver.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Google AI Studio key. Free tier covers Flash / Flash-Lite only (Pro went paid in Apr 2026).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# VERIFY BY HAND: open Texas A&M on ratemyprofessors.com and read the number after /school/.
# Blinn College is a separate id. The default below is a guess and must be confirmed.
RMP_SCHOOL_ID=1003

# Guards POST /admin/cache/invalidate. Any long random string.
ADMIN_TOKEN=

# Hot cache sizing. Defaults are in app/config.py; override only to tune.
# CACHE_PROFESSOR_SIZE=512
# CACHE_PROFESSOR_TTL=900
# CACHE_SEARCH_SIZE=256
# CACHE_WARM_COUNT=25

# Gemini batch summariser throttle. Keep at or below your project's free-tier RPM.
# SUMMARY_RPM=10
