# Supabase: dashboard -> Connect (top of the page) -> Session pooler.
# Session mode is the one to use: it keeps prepared statements and session state,
# which the transaction pooler on port 6543 drops. Session pooler is port 5432.
# Swap the scheme to postgresql+asyncpg:// for SQLAlchemy's async driver, and
# percent-encode any special characters in the password.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Google AI Studio key. Free tier covers Flash / Flash-Lite only (Pro went paid in Apr 2026).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Texas A&M at College Station. Confirmed from the pipeline's RMP cache:
# school.legacyId 1003, school.id "U2Nob29sLTEwMDM=" (base64 "School-1003").
# Galveston is 1006; Blinn College is a separate school entirely.
RMP_SCHOOL_ID=1003

# Guards POST /admin/cache/invalidate. Any long random string.
ADMIN_TOKEN=

# Hot cache sizing. Defaults are in app/config.py; override only to tune.
# CACHE_PROFESSOR_SIZE=512
# CACHE_PROFESSOR_TTL=900
# CACHE_SEARCH_SIZE=256
# CACHE_WARM_COUNT=25

# Gemini batch summariser throttle. Keep at or below your project's free-tier RPM.
# SUMMARY_RPM=10
